# Provider binding for aidd-chat. Copy to `.env` and fill in real values.
# `.env` is gitignored; this file must never contain a real endpoint or key.

# Deployment profile: local_test | public_demo
# local_test  -- may bind the deterministic stub (no endpoint) or a private LAN endpoint.
# public_demo -- refuses to start without an endpoint, and refuses a private,
#                loopback or link-local endpoint. It also refuses the deterministic
#                test provider, an active Retrieval, an unvalidatable public policy,
#                more than one worker or replica, and any Debug or Default Access
#                Log -- and refuses when the last two are not DECLARED, which is
#                why the four variables below are required under this profile.
#                Every refusal is fail-closed: the process starts, /ready answers
#                503, and the log names the Guard (and nothing else).
DEPLOYMENT_PROFILE=local_test

# What the operator DECLARES about how this process was launched -- as opposed to
# what it enforces, which is why these are not ceilings. Both counts must be
# exactly 1 under public_demo: every ceiling in this process is in-memory, so a
# second worker or replica silently halves all of them. Unset or blank is a
# refusal, never a default of 1.
#
# A declaration is all the guard can check. `uvicorn --workers 4` beside
# WEB_CONCURRENCY=1, or a platform that scaled the deployment out after it
# started, both pass. Confirming the real topology needs a platform-specific
# probe this app does not have.
WEB_CONCURRENCY=1
REPLICA_COUNT=1
# A level NAME -- info/warning/error/critical/fatal; a number is refused, because
# an operator who wrote 20 has almost certainly copied it from somewhere that meant
# something else. Any logger at DEBUG refuses too, not just the root. Uvicorn's own
# access log is disabled at startup either way; UVICORN_ACCESS_LOG must be unset or
# off so public_demo refuses a deployment that asked for it rather than silently
# overriding the operator.
LOG_LEVEL=info
# Must be declared off; unset is a refusal under public_demo, because uvicorn's
# own default for the access log is ON.
UVICORN_ACCESS_LOG=0

# Provider endpoint ORIGIN: scheme://host[:port]. A trailing /v1 path is ignored.
# Leave empty under local_test to bind the deterministic test provider instead.
# Credentials in this URL are rejected -- put the key in OLLAMA_API_KEY.
OLLAMA_BASE_URL=

# Provider credential. Read from the environment only; it never appears in a
# binding, a policy projection, a digest, a log line or an error envelope.
#
# NOTE: setting OLLAMA_BASE_URL while leaving this blank does NOT fail startup.
# The process starts and serves 503 on /ready and /api/v1/policy, and refuses
# questions, so the misconfiguration is visible on a health check instead of
# silently falling back to the deterministic stub.
# No default: unset means ABSENT, which is distinct from any value including the
# empty string, and is the normal state for a deterministic local_test binding.
# With an endpoint configured, absent and blank both fail closed -- /ready 503,
# never a silent fall back to the test provider.
OLLAMA_API_KEY=

# Attempts allowed per question lineage, counting the original question as 1.
# 1..8, and deliberately WITHOUT a default: how many times a user may re-ask one
# question is an operator decision, so the process refuses to start without it.
# Left empty here like every other key in this file -- an empty value is refused
# exactly as a missing one is.
MAX_ATTEMPTS_PER_LINEAGE=

# ---------------------------------------------------------------------------
# Capacity ceilings and rates. None of these has a default either: they describe a
# specific box, and a process that was never told them must not invent numbers and
# advertise itself as Ready. A missing or out-of-range value does NOT fail startup
# -- the process starts, serves 503 on /ready, refuses to create Conversations at
# all, and logs which setting is at fault (the name, never the value).
#
# Every one of them is range-validated; the range is stated on each line. The
# values below are a working starting point for a single-worker public demo.

# Conversations that may live in memory at once. (1..100000)
MAX_RESIDENT_CONVERSATIONS=200
# Runs in flight across the whole process, Queued and Active together. (1..1000)
MAX_GLOBAL_ACTIVE_RUNS=8
# Runs in flight for one session. (1..16)
# Session identity here IS the Conversation, and the Domain already permits at most
# one non-terminal Run per Conversation -- a second question is refused as
# `run_already_active` before capacity is consulted. This ceiling is therefore a
# backstop rather than the refusal a user normally sees. It becomes a visible
# refusal only once a session can span several Conversations.
MAX_SESSION_ACTIVE_RUNS=2
# Runs reserved but not yet started. Must be BELOW MAX_GLOBAL_ACTIVE_RUNS, or the
# Global ceiling always answers first and this one can never be reached. Enforced
# at startup. (1..1000)
MAX_QUEUED_RUNS=4
# Questions one Conversation may hold before 새 대화 is the only way on. (1..1000)
MAX_TURNS_PER_CONVERSATION=50
# Largest answer, in UTF-8 bytes, that may become a completed Message. (1024..4194304)
MAX_OUTPUT_BYTES=262144
# Replay Log ceilings for one Run, counted over the serialized Events -- envelopes
# included, not just the delta text. Delta commits stop four Events and 1 KiB short
# of these so a Run that reaches them can still write its terminal quadruple. Must
# be at least twice MAX_OUTPUT_BYTES -- the log holds the answer as Deltas and again
# as the message.completed echo. Enforced at startup. (16..1000000) and
# (4096..16777216)
MAX_REPLAY_EVENTS=5000
MAX_REPLAY_BYTES=1048576
# Concurrent SSE connections. A stream never outlives the Run it follows. (1..1000)
MAX_SSE_CONNECTIONS=32
# New Conversations one client IP may start per minute. Separate from the general
# per-IP budget below because a Conversation holds a resident slot for the full
# hour -- three orders of magnitude longer than the rate window -- so a refilling
# per-minute budget cannot stop one caller pinning every slot. (1..6000)
CREATE_RATE_PER_MINUTE=20
# Per-session rates, fixed 60 s window, keyed by Conversation Capability. A browser
# polls roughly 10x/s while a Run is live, so POLL is the one with real traffic
# behind it; opening an SSE stream is charged against it too. (1..6000) except POLL
# (1..60000).
SUBMIT_RATE_PER_MINUTE=60
POLL_RATE_PER_MINUTE=1200
RETRY_RATE_PER_MINUTE=30
CANCEL_RATE_PER_MINUTE=60
# Per-client-IP rate, fixed 60 s window, across every public API endpoint. Keep it
# comfortably ABOVE POLL_RATE_PER_MINUTE: several tabs, or several people behind
# one NAT, share this budget, and the per-session ceiling should be what bites in
# the ordinary case. Enforced at startup. (1..60000)
MAX_REQUESTS_PER_IP_PER_MINUTE=6000
# Provider calls actually in flight at once -- counted from the moment a Run
# starts, not from the moment it is queued. (1..64)
MAX_PROVIDER_CONCURRENCY=8
# Spend Circuit Breaker: how many units may be charged inside one window before no
# further Provider work starts. One started Provider call is one unit, which is
# what SPEND_UNIT declares -- the only meter this process can actually read.
# Reservations that have not charged yet count against the limit, so the window
# cannot overshoot by a burst. (1..86400) and (1..1000000)
SPEND_WINDOW_SECONDS=3600
SPEND_LIMIT_UNITS=2000
SPEND_UNIT=provider_call

# How many reverse proxies sit in front of this process. 0 means X-Forwarded-For is
# ignored entirely and only the socket peer counts -- the header is client
# controlled text until an operator states otherwise. Even when trusted, only a
# value that parses as an IP address is believed. (0..8)
TRUSTED_PROXY_HOPS=0
